{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Django release policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "repository",
    "branch",
    "workflow",
    "consumer",
    "project_id",
    "environment_id",
    "schema",
    "application",
    "acl_policy"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
    },
    "consumer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "name",
        "config",
        "root_directory",
        "start_command",
        "healthcheck_path",
        "restart_policy",
        "public_http"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "config": {
          "type": "null"
        },
        "root_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^/"
        },
        "start_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "healthcheck_path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^/"
            }
          ]
        },
        "restart_policy": {
          "enum": [
            "NEVER",
            "ON_FAILURE",
            "ALWAYS"
          ]
        },
        "public_http": {
          "type": "boolean"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "name",
        "config",
        "root_directory",
        "start_command",
        "healthcheck_path",
        "restart_policy",
        "public_http"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "config": {
          "type": "null"
        },
        "root_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^/"
        },
        "start_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "healthcheck_path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^/"
            }
          ]
        },
        "restart_policy": {
          "enum": [
            "NEVER",
            "ON_FAILURE",
            "ALWAYS"
          ]
        },
        "public_http": {
          "type": "boolean"
        }
      }
    },
    "acl_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    }
  }
}
